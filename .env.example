# ---- AI provider (for Copilot / RCA narrative) ----
# LLM_PROVIDER: none | anthropic | gemini | openai (or any OpenAI-compatible API via LLM_BASE_URL)
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
# Examples:
#   LLM_PROVIDER=anthropic  LLM_MODEL=claude-sonnet-4-6      LLM_API_KEY=sk-ant-...
#   LLM_PROVIDER=gemini     LLM_MODEL=gemini-1.5-flash       LLM_API_KEY=AIza...
#   LLM_PROVIDER=openai     LLM_MODEL=gpt-4o-mini             LLM_API_KEY=sk-...

# ---- Real database monitoring (all optional; unset = that collector stays off) ----
PG_DSN=
# e.g. PG_DSN=postgresql://user:password@localhost:5432/mydb
MYSQL_DSN=
# e.g. MYSQL_DSN=host=localhost;user=root;password=secret;database=mydb
REDIS_URL=
# e.g. REDIS_URL=redis://localhost:6379/0

# ---- Real Docker monitoring (backend-side; requires /var/run/docker.sock mounted) ----
DOCKER_MONITOR=0

# How often (seconds) the real collectors above poll their target
REAL_MONITOR_INTERVAL=5

# ---- Real Windows/Linux host agent (backend/agent.py) ----
# Shared secret the agent sends as "Authorization: Bearer <token>". Leave blank to allow any agent.
AGENT_TOKEN=
